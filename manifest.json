{
  "manifest_version": 3,
  "name": "Quiet Tab",
  "version": "0.1.0",
  "key": "",
  "description": "A quiet new-tab desktop of your favorite links and local weather — nothing else.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "favicon", "declarativeNetRequestWithHostAccess"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "nominatim_user_agent",
        "enabled": true,
        "path": "rules/nominatim-user-agent.json"
      }
    ]
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  }
}
